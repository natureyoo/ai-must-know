# Copy this file to .env and fill in values as needed.
# This file must never contain real secret values.

# Optional. GitHub personal access token, used only to raise the public API
# rate limit when collecting trending AI repositories. Collection still works
# without it (at GitHub's unauthenticated rate limit).
GITHUB_TOKEN=

# Optional. Which model writes the Korean text (src/translate):
#   claude — the Claude Code CLI (`claude -p`), billed to whatever it is logged
#            into: your subscription locally, CLAUDE_CODE_OAUTH_TOKEN in CI.
#   openai — the OpenAI API with OPENAI_API_KEY (the default).
# Without a working provider the dashboard still runs — untranslated stories
# fall back to the English original. Only new or changed items are ever sent.
TRANSLATOR=claude

# Optional. Claude Code model alias/id for TRANSLATOR=claude. Defaults to opus.
CLAUDE_MODEL=

# Optional. Long-lived token from `claude setup-token`, only needed where the
# CLI is not already logged in (CI). Never commit a real one.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. OpenAI API key for TRANSLATOR=openai.
OPENAI_API_KEY=

# Optional. Model for TRANSLATOR=openai. Defaults to gpt-4o.
OPENAI_MODEL=

# Optional. Max items translated per run, newest first. Defaults to 120.
TRANSLATE_LIMIT=

# Optional. HTTP port for the web server. Defaults to 3000 if unset.
PORT=

# Optional. Filesystem path to the local SQLite database file.
# Defaults to data/app.db if unset.
DB_PATH=
