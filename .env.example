# Copy this file to .env and fill in values as needed.
# This file must never contain real secret values.

# Optional. GitHub personal access token, used only to raise the public API
# rate limit when collecting trending AI repositories. Collection still works
# without it (at GitHub's unauthenticated rate limit).
GITHUB_TOKEN=

# Optional. OpenAI API key, used by `npm run collect` to render collected
# titles/summaries in Korean (src/translate). Without it the dashboard still
# runs — untranslated stories fall back to the English original. Only new or
# changed items are ever sent, so a daily run costs cents.
OPENAI_API_KEY=

# Optional. Model used for that translation. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Optional. HTTP port for the web server. Defaults to 3000 if unset.
PORT=

# Optional. Filesystem path to the local SQLite database file.
# Defaults to data/app.db if unset.
DB_PATH=
